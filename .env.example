# Optional local preview URL for share metadata. GitHub Actions sets this automatically.
NEXT_PUBLIC_SITE_URL=
# Leave blank for localhost or the root user.github.io site.
NEXT_PUBLIC_BASE_PATH=

# Public browser configuration. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SUBMISSIONS_ENABLED=
